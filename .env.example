# Server-side only. Never expose this with VITE_.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server-side Firebase Auth API key for /api/gemini admin-token checks.
# You may reuse VITE_FIREBASE_API_KEY on Vercel, or set this separate alias.
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_API_KEY"

# Optional comma-separated allowlist for API browser origins.
ALLOWED_ORIGINS="https://vbl-match-report-automator.vercel.app"

# Firebase web config. These values are allowed to be visible in the browser.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_DATABASE_ID="YOUR_FIREBASE_DATABASE_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
